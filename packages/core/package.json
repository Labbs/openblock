{
  "name": "@labbs/openblock-core",
  "version": "1.0.0",
  "description": "Framework-agnostic core for OpenBlock editor",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./standalone": {
      "types": "./dist/index.d.ts",
      "default": "./dist/standalone/openblock-core.esm.js"
    },
    "./standalone/iife": "./dist/standalone/openblock-core.iife.js",
    "./styles": "./dist/styles/editor.css",
    "./styles/editor.css": "./dist/styles/editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/standalone/*.map"
  ],
  "keywords": [
    "editor",
    "rich-text",
    "prosemirror",
    "block-editor",
    "wysiwyg",
    "notion-like",
    "typescript",
    "text-editor",
    "content-editor",
    "document-editor"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.standalone.config.ts && node ../../scripts/finalize-build.mjs --css src/styles/editor.css",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "y-prosemirror": "^1.3.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    },
    "y-prosemirror": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Labbs/openblock.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Labbs/openblock#readme",
  "bugs": {
    "url": "https://github.com/Labbs/openblock/issues"
  }
}
