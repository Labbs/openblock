{
  "name": "@labbs/openblock-react",
  "version": "1.0.0",
  "description": "React bindings for OpenBlock editor",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./standalone": {
      "types": "./dist/index.d.ts",
      "default": "./dist/standalone/openblock-react.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "editor",
    "rich-text",
    "prosemirror",
    "block-editor",
    "wysiwyg",
    "notion-like",
    "react",
    "react-hooks",
    "typescript",
    "text-editor"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.standalone.config.ts && node ../../scripts/finalize-build.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@labbs/openblock-core": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Labbs/openblock.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Labbs/openblock#readme",
  "bugs": {
    "url": "https://github.com/Labbs/openblock/issues"
  }
}
